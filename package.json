{
  "name": "retropocket-99in1",
  "version": "0.6.0",
  "description": "Consola portátil virtual 99-in-1 estilo Brick Game. 100% offline para web y Android.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "cap:add": "cap add android && node build/android-icons.js",
    "cap:icons": "node build/android-icons.js",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "apk": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "vite": "^8.3.5"
  }
}
